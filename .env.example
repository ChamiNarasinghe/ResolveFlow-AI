# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=resolveflow_db
POSTGRES_USER=resolveflow_user
POSTGRES_PASSWORD=replace_with_a_secure_password

# ── Database connection (used by the Go backend directly) ─────────────────────
# When running via docker-compose this is constructed automatically from the
# POSTGRES_* variables above. Set it explicitly only when running the backend
# outside of Docker (e.g. local development).
DATABASE_URL=postgres://resolveflow_user:replace_with_a_secure_password@localhost:5433/resolveflow_db?sslmode=disable

# ── JWT authentication ────────────────────────────────────────────────────────
# Must be at least 32 characters. Generate with: openssl rand -base64 32
JWT_SECRET=replace_this_with_a_secure_random_secret
JWT_EXPIRATION_MINUTES=15

# ── AI service ────────────────────────────────────────────────────────────────
# URL used by the Go backend to reach the AI service.
# When running via docker-compose this is set automatically to http://ai-service:8001.
# Override only for local development outside Docker.
AI_SERVICE_URL=http://127.0.0.1:8001

# Shared secret between the Go backend and the AI service.
# The Go backend sends this as the X-API-Key header.
# The AI service validates it. Leave empty to disable enforcement.
# Generate with: openssl rand -base64 32
AI_SERVICE_API_KEY=replace_with_a_secure_random_key

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
PORT=8080
LOG_LEVEL=info

# ── One-time admin bootstrap ──────────────────────────────────────────────────
# Set all three to create the initial administrator account on first startup.
# Once an admin exists the bootstrap is silently skipped on subsequent starts.
# Remove or leave blank after the first successful run.
# Never commit real credentials here.
# BOOTSTRAP_ADMIN_NAME=<full name>
# BOOTSTRAP_ADMIN_EMAIL=<admin email>
# BOOTSTRAP_ADMIN_PASSWORD=<strong password>
